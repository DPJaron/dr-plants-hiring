# Caddy serves the static site on the port Railway provides ($PORT).
:{$PORT:80} {
	root * /srv
	file_server
	encode zstd gzip

	# Long-cache the fingerprint-free static assets; HTML stays fresh.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
	header /index.html Cache-Control "no-cache"

	# Fallback to index.html so unknown paths still land on the page.
	try_files {path} {path}/ /index.html
}
